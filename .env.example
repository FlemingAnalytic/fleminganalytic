# Copy to .env.development and .env.production. Both are gitignored, which is
# why src/services/api.js still carries a correct fallback - on a fresh clone
# with no .env files, the fallback is what production ships with.
#
# No trailing '/api': the FastAPI routers are mounted at /stocks, /news,
# /chat, /analyst and so on, with no shared prefix.
VITE_API_URL=https://api.fleminganalytic.com
